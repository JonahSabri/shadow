# مسیر فایل دیتابیس SQLite محلی
DATABASE_PATH=db.sqlite3

# پورت این سرویس
PORT=8001

# کلید API برای محدودیت دسترسی (اختیاری — خالی = بدون محدودیت)
API_KEY=

# تعداد ثانیه‌های کش هر درخواست
CACHE_TTL=120

# دامنه‌ی منبع فایل‌های تصویر ملک‌ها — در صورت مقداردهی، تصاویر از طریق
# اندپوینت /media همین سرویس پروکسی می‌شوند تا این آدرس در خروجی دیده نشود
MEDIA_SOURCE=
